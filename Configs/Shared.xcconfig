// Every build setting the app target has, with the decision behind it.
// The project file holds none of its own (ADR 0006).

// ---- Identity -------------------------------------------------------------
PRODUCT_NAME = Vitrine
PRODUCT_BUNDLE_IDENTIFIER = com.tacomancy.vitrine
// Bumped by hand until v1 ships as 1.0.0 (ADR 0006).
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
// No committed Info.plist; the keys below are the whole of it.
GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSHumanReadableCopyright =
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// ---- Platform -------------------------------------------------------------
SDKROOT = macosx
// ADR 0006: macOS 26 only; no #available gating in v1.
MACOSX_DEPLOYMENT_TARGET = 26.0
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
// Xcode's new-project default; the legacy headermap style warns otherwise.
ALWAYS_SEARCH_USER_PATHS = NO

// ---- Swift ----------------------------------------------------------------
// ADR 0006: Swift 6 language mode; complete concurrency checking comes with it.
SWIFT_VERSION = 6.0
// Views are main-thread anyway; the core package is nonisolated (Package.swift).
SWIFT_DEFAULT_ACTOR_ISOLATION = MainActor
// Xcode 26 new-project default; nonisolated async runs on the caller's actor.
SWIFT_APPROACHABLE_CONCURRENCY = YES
// CODING_STANDARDS §8: warnings are errors, locally and in CI.
SWIFT_TREAT_WARNINGS_AS_ERRORS = YES
GCC_TREAT_WARNINGS_AS_ERRORS = YES
// Xcode compiles package targets with -suppress-warnings by default, which
// conflicts with the package's own treatAllWarnings(as: .error).
SWIFT_SUPPRESS_WARNINGS = NO
// No localization in v1 (ADR 0006).
SWIFT_EMIT_LOC_STRINGS = NO
ENABLE_PREVIEWS = YES

// ---- Signing and runtime --------------------------------------------------
// ADR 0006: "Sign to Run Locally"; no Apple Developer team.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
// Declared intent. Xcode forces this to NO while the identity is "-" (no
// notarization without a Developer ID); it takes effect if one is ever set.
ENABLE_HARDENED_RUNTIME = YES
// ADR 0006: no App Sandbox. The entitlements file says so explicitly.
ENABLE_APP_SANDBOX = NO
CODE_SIGN_ENTITLEMENTS = App/Vitrine.entitlements
ENABLE_USER_SCRIPT_SANDBOXING = YES
COMBINE_HIDPI_IMAGES = YES
